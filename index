    <style>
        :root {
            --page-dark: #090b1b;
            --section-dark: #0f1224;
            --panel-dark: #1b1b2f;
            --panel-border: #2a2f45;

            --text-main: #ffffff;
            --text-soft: #cbd5e1;
            --text-muted: #98a2b3;

            --amber: #ffcc70;
            --orange: #ff8c00;
            --red: #b22222;
            --cyan: #5ed1d1;

            --content-width: 1120px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            overflow-x: hidden;

            font-family:
                "Segoe UI",
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                sans-serif;

            color: var(--text-main);
            background: var(--page-dark);
        }

        a {
            color: inherit;
        }

        /* Header */

        .site-header {
            position: absolute;
            top: 0;
            left: 0;
            z-index: 20;

            width: 100%;
            padding: 22px 32px;

            background: rgba(3, 4, 14, 0.74);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(10px);
        }

        .header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;

            width: min(100%, var(--content-width));
            margin: 0 auto;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;

            text-decoration: none;
        }

        .brand-mark {
            width: 46px;
            height: 46px;
            object-fit: contain;
        }

      .site-name {
    font-family: "Trebuchet MS", "Avenir Next", "Segoe UI", sans-serif;
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.045em;

    background: linear-gradient(
        90deg,
        #ff3b1f 0%,
        #ff6a00 50%,
        #ffb000 100%
    );

    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    text-shadow: 0 0 24px rgba(255, 90, 0, 0.18);
}

        .main-nav {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        .main-nav a {
            color: var(--amber);
            font-weight: 650;
            text-decoration: none;
            transition:
                color 180ms ease,
                transform 180ms ease;
        }

        .main-nav a:hover {
            color: #ffffff;
            transform: translateY(-1px);
        }

        /* Hero */

        .hero {
            position: relative;
            isolation: isolate;

            display: flex;
            align-items: center;

            min-height: 830px;
            padding: 160px 32px 100px;

            overflow: hidden;

            background:
                linear-gradient(
                    115deg,
                    #4b0082,
                    #8d0d55,
                    #b22222,
                    #ff8c00
                );

            background-size: 400% 400%;
            animation: gradientShift 20s ease infinite;
        }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;

            background:
                radial-gradient(
                    circle at 25% 40%,
                    rgba(126, 42, 255, 0.28),
                    transparent 34%
                ),
                linear-gradient(
                    90deg,
                    rgba(6, 4, 26, 0.34),
                    rgba(6, 4, 26, 0.08)
                );
        }

        .hero-inner {
            position: relative;
            z-index: 2;

            display: grid;
            grid-template-columns: minmax(0, 1fr) 420px;
            align-items: center;
            gap: 60px;

            width: min(100%, var(--content-width));
            margin: 0 auto;
        }

        .hero-copy {
            max-width: 720px;
        }

        .eyebrow {
            margin: 0 0 20px;

            color: var(--amber);
            font-size: 0.8rem;
            font-weight: 750;
            letter-spacing: 0.18em;
            text-transform: uppercase;
        }

        .hero h1 {
            max-width: 760px;
            margin: 0;

            font-size: clamp(3.2rem, 7vw, 6.8rem);
            line-height: 0.96;
            letter-spacing: -0.065em;
        }

        .hero h1 span {
            display: block;

            background: linear-gradient(
                90deg,
                #ffffff 5%,
                #ddefff 48%,
                #70e3e3 100%
            );

            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-description {
            max-width: 650px;
            margin: 30px 0 0;

            color: rgba(255, 255, 255, 0.88);
            font-size: clamp(1.05rem, 2vw, 1.28rem);
            line-height: 1.65;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 38px;
        }

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;

            min-height: 52px;
            padding: 0 23px;

            border: 1px solid transparent;
            border-radius: 9px;

            font-weight: 750;
            text-decoration: none;

            transition:
                transform 180ms ease,
                box-shadow 180ms ease,
                background 180ms ease;
        }

        .button:hover {
            transform: translateY(-2px);
        }

        .button-primary {
            color: #ffffff;
            background: linear-gradient(
                90deg,
                var(--red),
                var(--orange)
            );

            box-shadow:
                0 12px 30px rgba(178, 34, 34, 0.32),
                0 0 24px rgba(255, 140, 0, 0.18);
        }

        .button-primary:hover {
            box-shadow:
                0 16px 38px rgba(178, 34, 34, 0.42),
                0 0 30px rgba(255, 140, 0, 0.25);
        }

        .button-secondary {
            color: #ffffff;
            background: rgba(5, 6, 20, 0.28);
            border-color: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(7px);
        }

        .button-secondary:hover {
            background: rgba(5, 6, 20, 0.46);
        }

        /* Neural graphic */

        .hero-graphic {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 520px;
        }

        .hero-graphic::before {
            content: "";
            position: absolute;

            width: 390px;
            height: 390px;

            border-radius: 50%;
            background: rgba(61, 225, 225, 0.15);
            filter: blur(70px);
        }

        .synapse-graphic {
            position: relative;
            z-index: 1;

            width: min(100%, 390px);
            max-height: 560px;
            object-fit: contain;

            opacity: 0.72;

            filter:
                drop-shadow(0 0 30px rgba(94, 209, 209, 0.25))
                drop-shadow(0 0 55px rgba(178, 34, 34, 0.18));
        }

        /* Information section */

        .platform-section {
            padding: 100px 32px;
            background: var(--section-dark);
        }

        .section-inner {
            width: min(100%, var(--content-width));
            margin: 0 auto;
        }

        .section-heading {
            max-width: 720px;
            margin-bottom: 46px;
        }

        .section-heading h2 {
            margin: 0 0 16px;
            font-size: clamp(2.2rem, 5vw, 3.8rem);
            line-height: 1.06;
            letter-spacing: -0.045em;
        }

        .section-heading p {
            margin: 0;
            color: var(--text-soft);
            font-size: 1.08rem;
            line-height: 1.7;
        }

        .panel-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .info-panel {
            position: relative;
            min-height: 250px;
            padding: 28px;

            overflow: hidden;

            background:
                linear-gradient(
                    145deg,
                    rgba(34, 34, 61, 0.98),
                    rgba(22, 22, 42, 0.98)
                );

            border: 1px solid var(--panel-border);
            border-radius: 14px;

            transition:
                transform 180ms ease,
                border-color 180ms ease,
                box-shadow 180ms ease;
        }

        .info-panel::after {
            content: "";
            position: absolute;
            top: -70px;
            right: -70px;

            width: 150px;
            height: 150px;

            border-radius: 50%;
            background: rgba(94, 209, 209, 0.08);
            filter: blur(10px);
        }

        .info-panel:hover {
            transform: translateY(-4px);
            border-color: rgba(94, 209, 209, 0.42);
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
        }

        .panel-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            width: 38px;
            height: 38px;
            margin-bottom: 28px;

            color: var(--amber);
            background: rgba(255, 204, 112, 0.09);
            border: 1px solid rgba(255, 204, 112, 0.25);
            border-radius: 9px;

            font-size: 0.8rem;
            font-weight: 800;
        }

        .info-panel h3 {
            margin: 0 0 12px;
            font-size: 1.25rem;
        }

        .info-panel p {
            margin: 0;
            color: #c9c9d1;
            line-height: 1.65;
        }

        /* Download section */

        .download-section {
            position: relative;
            padding: 110px 32px;

            overflow: hidden;

            background:
                linear-gradient(
                    120deg,
                    #090b1b,
                    #17112b 55%,
                    #2b101c
                );
        }

        .download-box {
            position: relative;
            width: min(100%, 900px);
            margin: 0 auto;
            padding: 58px;

            text-align: center;

            background: rgba(255, 255, 255, 0.055);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 18px;

            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.28);
            backdrop-filter: blur(10px);
        }

        .download-box h2 {
            margin: 0 0 16px;
            font-size: clamp(2.2rem, 5vw, 3.7rem);
            letter-spacing: -0.045em;
        }

        .download-box p {
            max-width: 630px;
            margin: 0 auto 30px;

            color: var(--text-soft);
            font-size: 1.08rem;
            line-height: 1.65;
        }

        .download-note {
            display: block;
            margin-top: 18px;

            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Footer and email */

        .site-footer {
            padding: 32px;

            color: var(--text-muted);
            background: #070914;
            border-top: 1px solid rgba(255, 255, 255, 0.07);
        }

        .footer-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;

            width: min(100%, var(--content-width));
            margin: 0 auto;
        }

        .footer-inner p {
            margin: 0;
        }

        .email-link {
            color: var(--amber);
            font-weight: 650;
            text-decoration: none;
        }

        .email-link:hover {
            color: #ffffff;
        }

        /* Contact */

        .contact-section {
            padding: 90px 32px;
            background: #0b0e20;
        }

        .contact-box {
            width: min(100%, 760px);
            margin: 0 auto;
            padding: 42px;
            background: rgba(255, 255, 255, 0.045);
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 16px;
        }

        .contact-box h2 {
            margin: 0 0 10px;
            font-size: clamp(2rem, 5vw, 3rem);
            letter-spacing: -0.04em;
        }

        .contact-box > p {
            margin: 0 0 28px;
            color: var(--text-soft);
            line-height: 1.65;
        }

        .contact-form {
            display: grid;
            gap: 18px;
        }

        .form-row {
            display: grid;
            gap: 7px;
        }

        .form-row label {
            color: var(--text-soft);
            font-weight: 650;
        }

        .form-row input,
        .form-row textarea {
            width: 100%;
            padding: 13px 14px;
            color: var(--text-main);
            background: #11152b;
            border: 1px solid #313752;
            border-radius: 8px;
            font: inherit;
        }

        .form-row textarea {
            min-height: 140px;
            resize: vertical;
        }

        .form-row input:focus,
        .form-row textarea:focus {
            outline: 2px solid rgba(94, 209, 209, 0.45);
            outline-offset: 1px;
            border-color: var(--cyan);
        }

        .legal-link {
    margin-top: 14px;
    padding: 7px 14px;

    color: var(--amber);
    background: transparent;

    border: 1px solid rgba(255, 204, 112, 0.45);
    border-radius: 7px;

    font-size: 0.8rem;
    font-weight: 650;

    cursor: pointer;
}

.legal-link:hover {
    color: #ffffff;
    border-color: var(--orange);
    background: rgba(255, 140, 0, 0.08);
}

.legal-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;

    display: none;
    align-items: center;
    justify-content: center;

    padding: 24px;

    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(8px);
}

.legal-modal.open {
    display: flex;
}

.legal-modal-box {
    position: relative;

    width: min(100%, 760px);
    max-height: 80vh;
    overflow-y: auto;

    padding: 36px;

    color: var(--text-main);
    background: #15172b;

    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;

    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
}

.legal-modal-box h2 {
    margin-top: 0;
}

.legal-modal-box p {
    color: var(--text-soft);
    line-height: 1.7;
}

.legal-close {
    position: absolute;
    top: 12px;
    right: 16px;

    color: #ffffff;
    background: transparent;
    border: 0;

    font-size: 2rem;
    cursor: pointer;
}

        .contact-form .button {
            justify-self: start;
            cursor: pointer;
        }

        @keyframes gradientShift {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        @media (max-width: 900px) {
            .hero-inner {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .hero-graphic {
                position: absolute;
                top: 165px;
                right: -90px;
                z-index: -1;

                width: 410px;
                opacity: 0.42;
            }

            .panel-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 650px) {
            .site-header {
                padding: 18px 20px;
            }

            .brand-mark {
                width: 38px;
                height: 38px;
            }

            .site-name {
                font-size: 1.7rem;
            }

            .main-nav {
                gap: 16px;
            }

            .hero {
                min-height: 760px;
                padding: 145px 20px 80px;
            }

            .hero h1 {
                font-size: clamp(3rem, 16vw, 4.7rem);
            }

            .hero-description {
                font-size: 1rem;
            }

            .hero-graphic {
                top: 150px;
                right: -170px;
                opacity: 0.3;
            }

            .platform-section,
            .download-section,
            .contact-section {
                padding: 76px 20px;
            }

            .download-box {
                padding: 40px 22px;
            }

            .contact-box {
                padding: 32px 22px;
            }

            .footer-inner {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            .hero {
                animation: none;
            }

            .button,
            .info-panel,
            .main-nav a {
                transition: none;
            }

        }
    </style>
</head>

